# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_data
DB_USER=readonly_user
DB_PASSWORD=change_me
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT=10

# Database bootstrap (used by rebuild_db.py)
ADMIN_HOST=127.0.0.1
ADMIN_PORT=3306
ADMIN_USER=root
ADMIN_PASSWORD=change_me
READONLY_USER=readonly_user
READONLY_PASSWORD=change_me

# OpenAI-compatible LLM endpoint
LLM_API_BASE=https://api.deepseek.com/v1
LLM_API_KEY=replace_with_your_api_key
LLM_MODEL_NAME=deepseek-chat
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# Services and security
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
STREAMLIT_PORT=8501
CORS_ALLOW_ORIGINS=http://127.0.0.1:8501,http://localhost:8501
IP_WHITELIST=127.0.0.1,::1
QUERY_MAX_ROWS=50
EXPORT_THRESHOLD=1000
AUDIT_LOG_PATH=./logs/audit.log

# V2 model registry and RAG
MODEL_REGISTRY_JSON=
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=
EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_DIMENSIONS=256
RAG_DB_PATH=./data/rag.sqlite3
RAG_TOP_K=5
RAG_AUTO_SYNC=true

# V2 Python analysis (Docker is the safe default)
PYTHON_EXECUTOR_MODE=docker
PYTHON_DOCKER_IMAGE=enterprise-data-analyst-python:latest
PYTHON_EXECUTION_TIMEOUT=60
PYTHON_MEMORY_LIMIT=512m
PYTHON_CPU_LIMIT=1.0
PYTHON_MAX_ROWS=5000
ALLOW_LOCAL_PYTHON_EXECUTION=false

# Reports
REPORT_OUTPUT_DIR=./outputs
ECHARTS_SCRIPT_URL=https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js

# API key authentication (set ADMIN_API_KEY before enabling)
API_KEY_AUTH_ENABLED=false
ADMIN_API_KEY=
API_KEY_DB_PATH=./data/api_keys.sqlite3
APP_API_KEY=
